# ---- DeepSeek (required for LLM reasoning; without it agents use deterministic fallbacks) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Storage / bus (defaults: SQLite + in-memory bus; docker-compose overrides to Postgres + Redis) ----
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/supplychain
# REDIS_URL=redis://localhost:6379/0

# ---- HITL guardrails ----
AUTO_APPROVE_LIMIT=2000
MIN_AUTO_SUPPLIER_RELIABILITY=0.70
MIN_AUTO_LLM_CONFIDENCE=0.5

# ---- Simulation ----
MONTE_CARLO_RUNS=10000
SIMULATION_HORIZON_DAYS=60

# ---- External data (optional) ----
ENABLE_EXTERNAL_POLLING=false
NEWSAPI_KEY=

# ---- Alerts & ERP (optional) ----
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ERP_WEBHOOK_URL=

CORS_ORIGINS=http://localhost:3000
