# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Generate secrets with:   python -c "import secrets; print(secrets.token_hex(24))"

# ---- Runtime mode ----------------------------------------------------------------------------------
# development: auth optional, demo data + reset button on (local use).  production: auth + webhook secret
# are mandatory, demo seeding and /api/admin/reset are off, API docs are hidden.
ENVIRONMENT=development

# ---- Authentication ----------------------------------------------------------------------------------
# Dashboard/approver keys as name:key:role (roles: viewer < approver < admin). The NAME is recorded as the
# reviewer on approvals. Keys must be >= 16 chars in production. Leave empty in development to disable auth.
API_KEYS=
# e.g. API_KEYS=alice:3f9c...:approver,bob:77aa...:viewer,root:91d0...:admin

# Shared secret for ingestion webhooks (ERP, supplier portal, IoT, trackers). Senders either
#   - send  X-Signature: sha256=<HMAC-SHA256(secret, body)>  (optionally with X-Timestamp; signed as "<ts>.<body>"), or
#   - send  X-Webhook-Secret: <secret>   (disable with WEBHOOK_ALLOW_PLAIN_SECRET=false)
WEBHOOK_SECRET=

# Demo data / admin reset. Defaults: on in development, off in production.
# SEED_DEMO_DATA=true
# ALLOW_ADMIN_RESET=true

# ---- Docker Compose only (required by docker-compose.yml) ----------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Where the BROWSER reaches the API, and which origin(s) the API accepts (your dashboard URL).
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Publish ports on all interfaces instead of loopback only (leave as is when a reverse proxy is on the host).
# BIND_ADDRESS=0.0.0.0

# ---- DeepSeek (LLM reasoning; without a key agents use deterministic fallbacks) ----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Spend guards: once today's usage reaches either cap, agents fall back to deterministic logic. 0 = unlimited.
LLM_DAILY_BUDGET_USD=5
LLM_DAILY_TOKEN_BUDGET=0

# ---- Storage / bus (non-Docker defaults: SQLite + in-memory bus) ----------------------------------------
# docker-compose.yml builds these itself. Set them for local runs or for docker-compose.cloud.yml.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/supplychain
# REDIS_URL=redis://:<password>@localhost:6379/0
#
# Supabase (Project -> Connect). postgresql:// is accepted and rewritten for the psycopg 3 driver. URL-encode special
# characters in the password. Prefer the SESSION pooler (port 5432 on the pooler host; works over IPv4 and supports
# the migration lock). The transaction pooler (port 6543) also works but skips that lock. Keep ?sslmode=require.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Hosted Redis (Upstash / Redis Cloud / ...): use rediss:// (TLS). It must support Streams (consumer groups).
# REDIS_URL=rediss://default:<password>@<host>:6379

# ---- HITL guardrails -----------------------------------------------------------------------------------
AUTO_APPROVE_LIMIT=2000
MIN_AUTO_SUPPLIER_RELIABILITY=0.70
MIN_AUTO_LLM_CONFIDENCE=0.5

# ---- Simulation ----------------------------------------------------------------------------------------
MONTE_CARLO_RUNS=10000
SIMULATION_HORIZON_DAYS=60

# ---- Rate limits (per API key / client IP, per minute; 0 disables). Add gateway limits too. ----------------
RATE_LIMIT_PER_MINUTE=600
INGEST_RATE_LIMIT_PER_MINUTE=1200

# ---- Embeddings for contract RAG -----------------------------------------------------------------------
# hash = offline, dependency-free (default). openai = any OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=hash
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBED_DIM=384        # must match the model output; after changing it run: python -m app.rag reindex

# ---- Live supplier pricing (optional; otherwise a price-drift model is used) ---------------------------------
# SUPPLIER_QUOTE_URL=https://pricing.example.com/quote
# SUPPLIER_QUOTE_API_KEY=

# ---- Live data feeds (optional) ------------------------------------------------------------------------------
ENABLE_EXTERNAL_POLLING=false      # Open-Meteo weather (+ NewsAPI headlines if NEWSAPI_KEY is set)
NEWSAPI_KEY=
ENABLE_TRACKING_POLLING=false      # carrier ETA pollers below (shipments need a tracking_ref)
# FLIGHTAWARE_API_KEY=             # air freight, FlightAware AeroAPI
# VESSEL_TRACKING_URL=https://api.example.com/vessels?imo={ref}
# VESSEL_TRACKING_API_KEY=
# VESSEL_TRACKING_KEY_HEADER=Authorization
# VESSEL_TRACKING_ETA_FIELD=data.0.eta
# MQTT_URL=mqtt://broker:1883      # IoT telemetry bridge
# MQTT_TOPIC=supplychain/telemetry/#

# ---- Alerts & ERP (optional) -------------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ERP_WEBHOOK_URL=
ERP_FLAVOR=generic                 # generic | sap | netsuite
# ERP_AUTH_HEADER=Authorization
# ERP_AUTH_VALUE=Bearer <token>

# ---- Observability ---------------------------------------------------------------------------------------------------
LOG_FORMAT=text                    # json for production log shippers
# METRICS_TOKEN=                   # if set, /metrics needs "Authorization: Bearer <token>"
